# ==============================================================================
# Umunna Pot — Environment Template (.env.example)
# Copy this file to .env.local and populate with your local credentials.
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_URL=https://umunna-pot.vercel.app
APPLICATION_URL=http://localhost:3000

# ==============================================================================
# AI Integration: OpenRouter (Phase 3 AI Drip Engine)
# Server-side only — NEVER prefix with NEXT_PUBLIC_
# ==============================================================================
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_FALLBACK_MODEL=google/gemini-4-argon
OPENROUTER_TIMEOUT_SECONDS=60

# ==============================================================================
# Base Sepolia (Chain ID: 84532) — Contracts & Web3 Configuration
# ==============================================================================
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_UMUNNA_POT_ADDRESS=0x0000000000000000000000000000000000000000

# Server-only Signers / Secret Keys (DO NOT EXPOSE TO BROWSER)
RELAYER_PRIVATE_KEY=
KEEPER_WALLET_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=

# ==============================================================================
# Roqqu API Services (RAS) — Server-Only Credentials
# Docs: https://roqqu-api-services.gitbook.io/ras
# ==============================================================================
ROQQU_BASE_URL=https://service.roqqu.com/v1
# Set to "staging" (sends x-staging-api-key) or "live" (sends x-api-key)
ROQQU_MODE=staging
ROQQU_SECRET_KEY=RASPRIV_YOUR_SECRET_KEY_HERE
ROQQU_PUBLIC_KEY=RASPUB_YOUR_PUBLIC_KEY_HERE
