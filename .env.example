# ==============================================================================
# Umunna Pot — Vercel & Production Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. For local development, copy this file to .env.local and fill in credentials.
# 2. For Vercel deployment, configure these key-value pairs in:
#    Vercel Dashboard -> Project Settings -> Environment Variables.
#
# IMPORTANT:
# - NEXT_PUBLIC_* variables are embedded in client bundles and exposed to the browser.
# - ALL other variables are strictly server-only. NEVER expose API keys or database
#   credentials via NEXT_PUBLIC_ variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Domain Configuration (Public & Server)
# ------------------------------------------------------------------------------
# Canonical publicly accessible URL of the deployed application (Client & Server)
NEXT_PUBLIC_APP_URL=https://umunna-pot.vercel.app

# Server-side fallback URL used for HTTP-Referer headers if NEXT_PUBLIC_APP_URL is unset (Server-Only)
APPLICATION_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. AI Integration: OpenRouter (Phase 3 AI Drip Engine)
# STRICTLY SERVER-ONLY — NEVER PREFIX WITH NEXT_PUBLIC_
# ------------------------------------------------------------------------------
# OpenRouter API Key (format: sk-or-v1-...). If omitted, the engine deterministically
# calculates safe schedules without failing.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# OpenRouter REST API base endpoint (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary AI model for schedule reasoning (default: anthropic/claude-sonnet-5.5)
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Optional fallback AI model if the primary model is unavailable or rate-limited
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash

# Maximum time in seconds to wait for AI inference before falling back deterministically.
# RECOMMENDED FOR VERCEL HOBBY TIER: 10 or 15 (to prevent serverless function timeouts).
# Pro tier can use 30 to 60.
OPENROUTER_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 3. Web3 & Base Sepolia Blockchain Configuration (Public / Client)
# ------------------------------------------------------------------------------
# JSON-RPC endpoint for Base Sepolia testnet.
# For production/demo reliability, use an authenticated provider (e.g. Alchemy or Infura).
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Target EVM Chain ID (84532 = Base Sepolia Testnet)
NEXT_PUBLIC_CHAIN_ID=84532

# Reown / WalletConnect Cloud Project ID (get one free at https://cloud.reown.com)
# Required for mobile QR wallet pairing via RainbowKit.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed MockUSDC (mUSDC) ERC-20 contract on Base Sepolia
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0xE9557485Ccd568c3984451f04f4ceF6E5b63809a

# Deployed UmunnaPot core vault contract on Base Sepolia
NEXT_PUBLIC_UMUNNA_POT_ADDRESS=0xf7D0aA978B6Ec7451a87Cc4457f282596a5df738

# ------------------------------------------------------------------------------
# 4. Database: MongoDB Atlas (Server-Only)
# STRICTLY SERVER-ONLY — NEVER PREFIX WITH NEXT_PUBLIC_
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., mongodb+srv://<username>:<password>@cluster.mongodb.net/)
# IMPORTANT FOR VERCEL: Ensure MongoDB Atlas Network Access allows connections
# from anywhere (0.0.0.0/0) or configure the MongoDB Atlas Vercel integration.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# MongoDB database name (defaults to umunna_pot if omitted)
MONGODB_DB=umunna_pot

# ------------------------------------------------------------------------------
# 5. Optional Fiat Ramp: Roqqu API Services (RAS) (Server-Only)
# STRICTLY SERVER-ONLY — NEVER PREFIX WITH NEXT_PUBLIC_
# ------------------------------------------------------------------------------
# Base URL for Roqqu API services
ROQQU_BASE_URL=https://service.roqqu.com/v1

# Mode flag: "staging" (sends x-staging-api-key) or "live" (sends x-api-key)
ROQQU_MODE=staging

# Roqqu Private Key for signing fiat checkout sessions and payouts
ROQQU_SECRET_KEY=RASPRIV_YOUR_SECRET_KEY_HERE

# Roqqu Public Key for authentication
ROQQU_PUBLIC_KEY=RASPUB_YOUR_PUBLIC_KEY_HERE

# ------------------------------------------------------------------------------
# 6. Optional Blockchain Operational Keys (Foundry & Scripts Only)
# STRICTLY SERVER-ONLY — NEVER COMMIT OR EXPOSE IN VERCEL CLIENT BUNDLES
# ------------------------------------------------------------------------------
# Relayer private key for gasless meta-transactions (optional)
RELAYER_PRIVATE_KEY=

# Automated keeper bot wallet private key for automated scheduled releases (optional)
KEEPER_WALLET_PRIVATE_KEY=

# Deployer wallet private key used only for Foundry Forge deployment scripts (optional)
DEPLOYER_PRIVATE_KEY=
